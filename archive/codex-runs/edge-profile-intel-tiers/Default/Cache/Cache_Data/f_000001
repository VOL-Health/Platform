    .path-column-head span,
    .projected-reduction-callout span,
    .model-assumptions span,
    .path-effect-item span{
      display:block;
      color:rgba(255,255,255,0.58);
      font-size:10.5px;
      line-height:1.2;
      font-weight:800;
      letter-spacing:0.07em;
      text-transform:uppercase;
    }

    .path-column-head strong{
      display:block;
      margin-top:7px;
      color:#ffffff;
      font-size:clamp(22px, 2.2vw, 30px);
      line-height:1.05;
      font-weight:800;
    }

    .path-column-head em{
      display:block;
      margin-top:6px;
      color:rgba(255,255,255,0.68);
      font-size:12px;
      line-height:1.35;
      font-style:normal;
      font-weight:500;
    }

    .projected-reduction-callout{
      margin-top:12px;
      padding:12px;
      border-radius:14px;
      border:1px solid rgba(53,198,122,0.22);
      background:rgba(53,198,122,0.08);
    }

    .projected-reduction-callout strong{
      display:block;
      margin-top:4px;
      color:#dffbea;
      font-size:28px;
      line-height:1;
      font-weight:800;
    }

    .path-effect-list{
      display:grid;
      gap:8px;
      margin-top:14px;
    }

    .path-effect-item{
      padding:10px;
      border-radius:12px;
      border:1px solid rgba(255,255,255,0.075);
      background:rgba(255,255,255,0.028);
