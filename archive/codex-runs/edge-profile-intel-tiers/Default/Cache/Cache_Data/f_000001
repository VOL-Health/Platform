      padding:12px;
      border-bottom:1px solid rgba(255,255,255,0.08);
      background:rgba(44,108,255,0.12);
    }

    .decision-window-head strong{
      color:#dbe6ff;
      font-size:11px;
      line-height:1.2;
      font-weight:800;
      text-transform:uppercase;
