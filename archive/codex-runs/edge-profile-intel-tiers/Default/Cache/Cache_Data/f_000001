      border:1px solid rgba(255,255,255,0.10);
      background:rgba(255,255,255,0.032);
    }

    .projected-path{
      border-color:rgba(53,198,122,0.25);
      background:linear-gradient(180deg, rgba(53,198,122,0.075), rgba(255,255,255,0.025));
