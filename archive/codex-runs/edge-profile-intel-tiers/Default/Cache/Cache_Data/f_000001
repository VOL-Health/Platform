    .path-effect-item strong{
      display:block;
      margin-top:5px;
      color:rgba(255,255,255,0.84);
      font-size:12px;
      line-height:1.4;
      font-weight:700;
    }

    .path-note{
      margin:13px 0 0;
      color:rgba(255,255,255,0.72);
      font-size:12.5px;
      line-height:1.5;
      font-weight:500;
    }

    .model-assumptions{
      margin-top:14px;
      padding:12px 14px;
      border-radius:14px;
      border:1px solid rgba(255,255,255,0.09);
      background:rgba(255,255,255,0.026);
    }

    .model-assumptions p{
      display:inline;
      margin:6px 16px 0 0;
      color:rgba(255,255,255,0.66);
      font-size:11.5px;
      line-height:1.45;
      font-weight:500;
    }

    table{
      width:100%;
      border-collapse:collapse;
      min-width:0;
      table-layout:fixed;
    }

    th,
    td{
      padding:7px 8px;
      border-bottom:1px solid rgba(255,255,255,0.07);
      text-align:left;
      font-size:11.25px;
      line-height:1.25;
      white-space:normal;
      vertical-align:middle;
    }

    .trend-table th:nth-child(1){ width:70px; }
    .trend-table th:nth-child(2){ width:88px; }
    .trend-table th:nth-child(3){ width:210px; }
    .trend-table th:nth-child(4){ width:auto; }
    .trend-table th:nth-child(5){ width:246px; }
    .trend-table th:nth-child(6){ width:106px; }

    th{
      color:rgba(255,255,255,0.62);
      font-weight:700;
      letter-spacing:0.06em;
      text-transform:uppercase;
      background:rgba(255,255,255,0.03);
    }

    td{
      color:rgba(255,255,255,0.78);
      font-weight:500;
    }

    tbody tr:last-child td{ border-bottom:0; }
    tbody tr.latest-row td{
      color:#ffffff;
      background:rgba(53,198,122,0.07);
    }

    tbody tr.row-stable td:first-child{
      border-left:3px solid rgba(53,198,122,0.58);
    }

    tbody tr.row-building td:first-child{
      border-left:3px solid rgba(246,180,75,0.68);
    }

    tbody tr.row-severe td:first-child{
      border-left:3px solid rgba(240,97,97,0.72);
    }

    tbody tr.row-stable td{
      background:rgba(53,198,122,0.018);
    }

    tbody tr.row-building td{
      background:rgba(246,180,75,0.025);
    }

    tbody tr.row-severe td{
      background:rgba(240,97,97,0.026);
    }

    tbody tr.row-calm td{
      background:rgba(255,255,255,0.010);
    }

    tbody tr.row-calm td:first-child{
      border-left:3px solid rgba(255,255,255,0.08);
    }

    tbody tr:hover td{
      background:rgba(255,255,255,0.055);
    }

    tbody tr.decision-critical_window td,
    tbody tr.decision-escalation_window td,
    tbody tr.decision-recommended_action td{
      background:rgba(44,108,255,0.105);
      box-shadow:inset 0 1px 0 rgba(255,255,255,0.08), inset 0 -1px 0 rgba(255,255,255,0.08);
    }

    tbody tr.decision-critical_window td:first-child,
    tbody tr.decision-escalation_window td:first-child,
    tbody tr.decision-recommended_action td:first-child{
      border-left:3px solid rgba(44,108,255,0.92);
    }

    tbody tr.decision-critical_window td{
      background:rgba(240,97,97,0.09);
    }

    tbody tr.decision-critical_window td:first-child{
      border-left-color:rgba(240,97,97,0.95);
    }

    tbody tr.decision-stabilization_watch td{
      background:rgba(53,198,122,0.08);
      box-shadow:inset 0 1px 0 rgba(255,255,255,0.07), inset 0 -1px 0 rgba(255,255,255,0.07);
    }

    tbody tr.decision-stabilization_watch td:first-child{
      border-left:3px solid rgba(53,198,122,0.86);
    }

    tbody tr.decision-hindsight td{
      background:rgba(246,180,75,0.035);
    }

