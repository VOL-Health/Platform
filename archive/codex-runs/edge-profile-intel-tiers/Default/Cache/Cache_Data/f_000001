<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>VOL Health | Data Demo</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    :root{
      --bg:#07111f;
      --bg-2:#0c1830;
      --panel:rgba(13,18,36,0.96);
      --panel-2:rgba(17,24,46,0.94);
      --panel-3:rgba(12,20,40,0.88);
      --line:rgba(255,255,255,0.10);
      --line-2:rgba(255,255,255,0.16);
      --text:#eef4ff;
      --muted:#9fb2d2;
      --muted-2:rgba(255,255,255,0.78);
      --blue:#2c6cff;
      --green:#35c67a;
      --green-2:#28a862;
      --amber:#f6b44b;
      --red:#f06161;
      --shadow:0 14px 34px rgba(0,0,0,0.34);
      --shadow-lg:0 24px 60px rgba(0,0,0,0.34);
      --radius-xl:22px;
      --radius-lg:20px;
      --radius-md:16px;
      --radius-sm:12px;
    }

    *{ box-sizing:border-box; }
    html,body{ min-height:100%; }

    body{
      margin:0;
      font-family:"Montserrat", "Inter", Arial, Helvetica, sans-serif;
      color:var(--text);
      background:
        radial-gradient(circle at top left, rgba(44,108,255,0.17), transparent 30%),
        radial-gradient(circle at top right, rgba(53,198,122,0.10), transparent 24%),
        linear-gradient(180deg, #06101e 0%, #081424 42%, #06101d 100%);
    }

    button,
    input,
    select,
    textarea{ font-family:inherit; }

    a{ color:inherit; text-decoration:none; }

    .shell{
      width:min(1320px, calc(100% - 28px));
      margin:20px auto 40px;
      padding:0 0 30px;
    }

    .platform-header{
      margin-bottom:4px;
      padding:12px 14px 0;
    }

    .platform-header-top{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:22px;
      margin-bottom:12px;
    }

    .platform-brand{ min-width:0; }

    .vol-logo-horizontal{
      display:inline-flex;
      align-items:center;
      gap:0.08em;
      font-size:clamp(34px, 4.2vw, 56px);
      font-weight:300;
      letter-spacing:0.08em;
      line-height:1;
      color:#ffffff;
      white-space:nowrap;
    }

    .logo-letter{ color:#ffffff; }

    .logo-o{
      width:0.76em;
      height:0.76em;
      border-radius:50%;
      border:0.065em solid #4f82ff;
      display:inline-block;
      position:relative;
      transform:translateY(0.035em);
      box-shadow:
        inset 0 0 0.22em rgba(79,130,255,0.22),
        0 0 0.18em rgba(79,130,255,0.18);
    }

    .logo-o::after{
      content:"";
      position:absolute;
      inset:-0.08em;
      border-radius:50%;
      border-top:0.035em solid rgba(255,255,255,0.30);
      border-right:0.035em solid rgba(79,130,255,0.72);
      border-bottom:0.035em solid transparent;
      border-left:0.035em solid transparent;
      transform:rotate(-28deg);
    }

    .logo-gap{ width:0.26em; }

    .platform-nav{
      display:flex;
      align-items:center;
      justify-content:flex-end;
      flex-wrap:wrap;
      gap:10px;
    }

    .nav-pill{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:10px 14px;
      border-radius:999px;
      border:1px solid rgba(255,255,255,0.12);
      background:rgba(255,255,255,0.04);
      color:#eef4ff;
      font-size:12px;
      font-weight:600;
      letter-spacing:0.04em;
      white-space:nowrap;
      transition:background 0.14s ease, border-color 0.14s ease, transform 0.14s ease, box-shadow 0.14s ease;
    }

    .nav-pill:hover{
      background:rgba(255,255,255,0.08);
      border-color:rgba(255,255,255,0.24);
      transform:translateY(-1px);
    }

    .nav-pill.active{
      background:rgba(44,108,255,0.18);
      border-color:rgba(44,108,255,0.60);
      color:#ffffff;
      box-shadow:
        0 0 0 1px rgba(44,108,255,0.35),
        0 4px 14px rgba(44,108,255,0.25);
    }

    .page{
      padding:8px 14px 32px;
      background:linear-gradient(180deg, rgba(255,255,255,0.00) 0%, rgba(255,255,255,0.015) 24%, rgba(255,255,255,0.025) 100%);
      border-radius:22px;
    }

    .intro-card,
    .panel,
    .community-card,
    .metric-card{
      background:var(--panel-2);
      border:1px solid var(--line);
      box-shadow:var(--shadow);
    }

    .intro-card{
      border-radius:20px;
      padding:20px;
      background:linear-gradient(180deg, rgba(8,16,35,0.92), rgba(8,16,35,0.64));
      margin-bottom:18px;
    }

    .page-kicker,
    .disclaimer-pill{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:6px 12px;
      border-radius:999px;
      border:1px solid rgba(44,108,255,0.35);
      background:rgba(44,108,255,0.12);
      color:#dbe6ff;
      font-size:11px;
      font-weight:700;
      letter-spacing:0.04em;
      margin-bottom:12px;
    }

    .page-title{
      margin:0 0 12px;
      max-width:1060px;
      font-size:clamp(28px, 3.3vw, 44px);
      line-height:1.08;
      font-weight:700;
      letter-spacing:0;
      color:rgba(255,255,255,0.92);
    }

    .page-subtitle{
      margin:0;
      max-width:840px;
      color:rgba(255,255,255,0.78);
      font-size:clamp(15px, 1.5vw, 18px);
      line-height:1.55;
      font-weight:400;
    }

    .disclaimer-pill{
      margin:18px 0 0;
      border-color:rgba(53,198,122,0.38);
      background:rgba(53,198,122,0.12);
      color:#dffbea;
      text-transform:none;
      letter-spacing:0;
    }

    .section-head{
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap:18px;
      margin:20px 0 12px;
    }

    .section-head h2{
      margin:0;
      font-size:clamp(18px, 2vw, 24px);
      line-height:1.18;
      font-weight:700;
      color:rgba(255,255,255,0.92);
    }

    .section-head p{
      margin:6px 0 0;
      max-width:min(1100px, 100%);
      color:rgba(255,255,255,0.72);
      line-height:1.55;
      font-size:14px;
    }

    .community-grid{
      display:grid;
      grid-template-columns:repeat(5, minmax(0,1fr));
      gap:12px;
    }

    .community-card{
      width:100%;
      min-height:142px;
      padding:15px;
      border-radius:16px;
      color:inherit;
      text-align:left;
      cursor:pointer;
      transition:transform 0.14s ease, border-color 0.14s ease, background 0.14s ease, box-shadow 0.14s ease;
    }

    .community-card:hover{
      transform:translateY(-1px);
      border-color:rgba(255,255,255,0.22);
      background:rgba(18,31,59,0.98);
    }

    .community-card.active{
      border-color:rgba(53,198,122,0.60);
      box-shadow:
        0 0 0 1px rgba(53,198,122,0.28),
        0 14px 34px rgba(0,0,0,0.34);
      background:linear-gradient(180deg, rgba(20,42,67,0.98), rgba(15,31,59,0.96));
    }

    .community-card.severity-stable.active{
      border-color:rgba(53,198,122,0.66);
      box-shadow:
        0 0 0 1px rgba(53,198,122,0.30),
        0 14px 34px rgba(0,0,0,0.34),
        0 0 22px rgba(53,198,122,0.12);
    }

    .community-card.severity-strained.active{
      border-color:rgba(246,180,75,0.70);
      box-shadow:
        0 0 0 1px rgba(246,180,75,0.30),
        0 14px 34px rgba(0,0,0,0.34),
        0 0 22px rgba(246,180,75,0.12);
    }

    .community-card.severity-high.active{
      border-color:rgba(243,139,70,0.72);
      box-shadow:
        0 0 0 1px rgba(243,139,70,0.30),
        0 14px 34px rgba(0,0,0,0.34),
        0 0 22px rgba(243,139,70,0.12);
    }

    .community-card.severity-critical.active{
      border-color:rgba(240,97,97,0.72);
      box-shadow:
        0 0 0 1px rgba(240,97,97,0.32),
        0 14px 34px rgba(0,0,0,0.34),
        0 0 22px rgba(240,97,97,0.13);
    }

    .community-card.severity-recovery.active{
      border-color:rgba(69,177,209,0.72);
      box-shadow:
        0 0 0 1px rgba(53,198,122,0.24),
        0 14px 34px rgba(0,0,0,0.34),
        0 0 24px rgba(44,108,255,0.14);
    }

    .community-card .eyebrow,
    .label{
      color:rgba(255,255,255,0.62);
      font-size:11px;
      line-height:1.25;
      font-weight:700;
      letter-spacing:0.08em;
      text-transform:uppercase;
    }

    .community-card strong{
      display:block;
      margin:9px 0 10px;
      color:rgba(255,255,255,0.92);
      font-size:15px;
      line-height:1.25;
      font-weight:700;
    }

    .scenario-tag{
      display:inline-flex;
      align-items:center;
      min-height:28px;
      padding:6px 9px;
      border-radius:999px;
      background:rgba(44,108,255,0.13);
      border:1px solid rgba(44,108,255,0.28);
      color:#dbe6ff;
      font-size:11px;
      font-weight:600;
      line-height:1.25;
    }

    .dashboard-grid{
      display:grid;
      grid-template-columns:minmax(0, 1.05fr) minmax(330px, 0.65fr);
      gap:16px;
      align-items:start;
    }

    .panel{
      border-radius:20px;
      padding:18px;
    }

    .panel-title{
      margin:0 0 14px;
      font-size:18px;
      line-height:1.18;
      font-weight:700;
      color:rgba(255,255,255,0.92);
    }

    .profile-grid{
      display:grid;
      grid-template-columns:repeat(4, minmax(0,1fr));
      gap:10px;
    }

    .profile-cell{
      min-height:86px;
      padding:13px;
      border-radius:14px;
      background:rgba(255,255,255,0.035);
      border:1px solid rgba(255,255,255,0.08);
    }

    .profile-cell .value{
      margin-top:8px;
      color:rgba(255,255,255,0.90);
      font-weight:700;
      line-height:1.25;
    }

    .score-row{
      display:grid;
      grid-template-columns:repeat(2, minmax(0,1fr));
      gap:10px;
      margin-bottom:12px;
    }

    .score-card{
      padding:16px;
      border-radius:16px;
      background:rgba(255,255,255,0.035);
      border:1px solid rgba(255,255,255,0.08);
    }

    .score-value{
      margin-top:8px;
      font-size:42px;
      line-height:0.95;
      font-weight:700;
      color:#ffffff;
    }

    .score-note{
      margin-top:8px;
      color:rgba(255,255,255,0.70);
      font-size:12px;
      line-height:1.45;
    }

    .decision-list{
      display:grid;
      gap:10px;
    }

    .decision-item{
      padding:13px;
      border-radius:14px;
      background:rgba(255,255,255,0.035);
      border:1px solid rgba(255,255,255,0.08);
    }

    .decision-item .value{
      margin-top:6px;
      color:rgba(255,255,255,0.88);
      line-height:1.45;
      font-weight:600;
    }

    .executive-intel-card{
      position:relative;
      padding:16px;
      border-radius:20px;
      border:1px solid rgba(53,198,122,0.22);
      background:linear-gradient(180deg, rgba(17,24,46,0.98), rgba(12,20,40,0.94));
      box-shadow:
        0 18px 42px rgba(0,0,0,0.30),
        inset 0 1px 0 rgba(255,255,255,0.04);
      overflow:hidden;
    }

    .executive-intel-card::before{
      content:"";
      position:absolute;
      left:0;
      right:0;
      top:0;
      height:1px;
      background:linear-gradient(90deg, transparent, rgba(53,198,122,0.34), rgba(44,108,255,0.22), transparent);
    }

    .exec-intel-main{
      display:grid;
      grid-template-columns:minmax(0, 0.86fr) minmax(360px, 0.86fr);
      gap:14px;
      align-items:stretch;
    }

    .exec-left,
    .exec-right{
      min-width:0;
    }

    .exec-interpretation-strip{
      display:grid;
      grid-template-columns:1.35fr 1.35fr 0.8fr 0.8fr;
      gap:0;
      border:1px solid rgba(255,255,255,0.08);
      border-radius:12px;
      background:rgba(255,255,255,0.028);
      overflow:hidden;
    }

    .exec-interpretation-strip > div{
      min-width:0;
      padding:10px 11px;
      border-right:1px solid rgba(255,255,255,0.075);
    }

    .exec-interpretation-strip > div:last-child{
      border-right:0;
    }

    .exec-interpretation-strip span{
      display:block;
      color:rgba(255,255,255,0.52);
      font-size:10.5px;
      line-height:1.15;
      font-weight:800;
      letter-spacing:0.05em;
      text-transform:uppercase;
    }

    .exec-interpretation-strip strong{
      display:block;
      margin-top:5px;
      color:rgba(255,255,255,0.90);
      font-size:13px;
      line-height:1.3;
      font-weight:650;
    }

    .exec-metric,
    .exec-cta-grid > div{
      padding:11px;
      border-radius:12px;
      background:rgba(255,255,255,0.035);
      border:1px solid rgba(255,255,255,0.08);
    }

    .exec-cta-grid strong{
      display:block;
      margin-top:5px;
      color:rgba(255,255,255,0.90);
      font-size:13px;
      line-height:1.3;
    }

    .exec-right{
      display:grid;
      grid-template-columns:repeat(2, minmax(0,1fr));
      gap:8px;
    }

    .exec-metric span{
      display:block;
      color:rgba(255,255,255,0.62);
      font-size:11px;
      line-height:1.25;
      font-weight:700;
      letter-spacing:0.08em;
      text-transform:uppercase;
    }

    .exec-metric strong{
      display:block;
      margin-top:6px;
      color:#ffffff;
      font-size:clamp(18px, 2vw, 30px);
      line-height:1.05;
      font-weight:700;
    }

    .exec-metric em{
      display:block;
      margin-top:7px;
      color:rgba(255,255,255,0.62);
      font-size:11.5px;
      line-height:1.35;
      font-style:normal;
      font-weight:500;
    }

    .exec-interpretation{
      margin:12px 0 0;
      padding:12px 13px;
      border-radius:12px;
      background:rgba(53,198,122,0.08);
      border:1px solid rgba(53,198,122,0.18);
      color:rgba(255,255,255,0.84);
      font-size:14px;
      line-height:1.5;
      font-weight:500;
    }

    .exec-cta-grid{
      display:grid;
      grid-template-columns:repeat(3, minmax(0,1fr));
      gap:8px;
      margin-top:10px;
    }

    .exec-booking-row{
      display:flex;
      justify-content:flex-end;
      margin-top:12px;
    }

    .metric-grid{
      display:grid;
      grid-template-columns:repeat(4, minmax(0,1fr));
      gap:12px;
    }

    .metric-card{
      min-height:118px;
      padding:15px;
      border-radius:16px;
    }

    .metric-value{
      margin-top:10px;
      color:rgba(255,255,255,0.92);
      font-size:24px;
      line-height:1.05;
      font-weight:700;
    }

    .metric-note{
      margin-top:8px;
      color:rgba(255,255,255,0.70);
      font-size:12px;
      line-height:1.45;
    }

    .fingerprint-panel{
      position:relative;
      background:linear-gradient(180deg, rgba(17,24,46,0.96), rgba(14,20,40,0.92));
      box-shadow:
        0 14px 34px rgba(0,0,0,0.28),
        inset 0 1px 0 rgba(255,255,255,0.04);
      overflow:hidden;
    }

    .fingerprint-panel::before{
      content:"";
      position:absolute;
      left:0;
      right:0;
      top:0;
      height:1px;
      background:linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.14) 20%, rgba(255,255,255,0.06) 80%, transparent 100%);
    }

    .fingerprint-chart-shell{
      border:1px solid rgba(255,255,255,0.10);
      background:linear-gradient(180deg, rgba(255,255,255,0.025), rgba(0,0,0,0.16));
      border-radius:18px;
      padding:8px;
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.03),
        inset 0 -20px 40px rgba(0,0,0,0.14);
    }

    .fingerprint-chart{
      display:block;
      width:100%;
      height:auto;
      max-height:238px;
      min-height:198px;
      border-radius:14px;
    }

    .fingerprint-line{
      fill:none;
      stroke-width:3.2;
      stroke-linecap:round;
      stroke-linejoin:round;
      filter:drop-shadow(0 4px 10px rgba(0,0,0,0.30));
    }

    .vi-line{
      stroke:#35c67a;
    }

    .wsi-line{
      stroke:#2c6cff;
    }

    .fingerprint-axis line{
      stroke:rgba(255,255,255,0.35);
      stroke-width:1.6;
    }

    .fingerprint-ticks text,
    .fingerprint-axis-label,
    .fingerprint-baseline,
    .pressure-label,
    .latest-label{
      fill:rgba(255,255,255,0.64);
      font-family:"Montserrat", "Inter", Arial, Helvetica, sans-serif;
      font-size:11px;
      font-weight:700;
      letter-spacing:0;
    }

    .fingerprint-axis-label,
    .fingerprint-baseline{
      fill:rgba(255,255,255,0.74);
    }

    .pressure-marker{
      stroke:rgba(240,97,97,0.34);
      stroke-width:1.5;
      stroke-dasharray:5 7;
    }

    .pressure-dot{
      fill:#f06161;
      stroke:#ffffff;
      stroke-width:1.6;
    }

    .pressure-label{
      fill:#ffb8b8;
    }

    .latest-label{
      fill:rgba(255,255,255,0.86);
    }

    .fingerprint-legend{
      display:flex;
      flex-wrap:wrap;
      gap:9px 16px;
      margin-top:12px;
      color:rgba(255,255,255,0.72);
      font-size:12px;
      line-height:1.35;
      font-weight:600;
    }

    .fingerprint-legend span{
      display:inline-flex;
      align-items:center;
      gap:7px;
    }

    .fingerprint-legend i{
      width:22px;
      height:0;
      border-top:3px solid rgba(255,255,255,0.50);
      display:inline-block;
    }

    .fingerprint-legend .legend-vi{
      border-top-color:#35c67a;
    }

    .fingerprint-legend .legend-wsi{
      border-top-color:#2c6cff;
    }

    .fingerprint-legend .legend-baseline{
      border:1px solid rgba(255,255,255,0.50);
      border-width:0;
      border-top:2px dashed rgba(255,255,255,0.50);
    }

    .fingerprint-interpretation{
      margin:10px 0 0;
      color:rgba(255,255,255,0.82);
      font-size:14px;
      line-height:1.55;
      font-weight:600;
    }

    .intelligence-panel{
      position:relative;
      margin-top:-2px;
      padding:18px;
      border-radius:20px;
      border:1px solid rgba(255,255,255,0.11);
      background:linear-gradient(180deg, rgba(17,24,46,0.96), rgba(14,20,40,0.92));
      box-shadow:
        0 14px 34px rgba(0,0,0,0.28),
        inset 0 1px 0 rgba(255,255,255,0.04);
    }

    .intelligence-panel::before{
      content:"";
      position:absolute;
      left:36px;
      right:36px;
      top:-14px;
      height:14px;
      border-left:1px solid rgba(53,198,122,0.28);
      border-right:1px solid rgba(44,108,255,0.24);
      border-top:1px solid rgba(255,255,255,0.08);
      border-radius:14px 14px 0 0;
      opacity:0.8;
    }

    .intelligence-flow{
      display:grid;
      grid-template-columns:repeat(4, minmax(0,1fr));
      gap:8px;
      margin-bottom:14px;
      color:rgba(255,255,255,0.62);
      font-size:11px;
      font-weight:700;
      letter-spacing:0.08em;
      line-height:1.25;
      text-transform:uppercase;
    }

    .intelligence-flow span{
      min-height:30px;
      padding:8px 10px;
      border-radius:999px;
      border:1px solid rgba(255,255,255,0.08);
      background:rgba(255,255,255,0.025);
      text-align:center;
    }

    .timeline-list{
      position:relative;
      display:grid;
      gap:10px;
    }

    .timeline-list::before{
      content:"";
      position:absolute;
      left:18px;
      top:14px;
      bottom:14px;
      width:1px;
      background:linear-gradient(180deg, rgba(53,198,122,0.44), rgba(44,108,255,0.24));
    }

    .timeline-event{
      position:relative;
      border:1px solid rgba(255,255,255,0.09);
      border-radius:16px;
      background:rgba(255,255,255,0.032);
      overflow:hidden;
    }

    .timeline-event::before{
      content:"";
      position:absolute;
      left:13px;
