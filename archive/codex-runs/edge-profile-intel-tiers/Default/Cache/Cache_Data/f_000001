    }

    .decision-drag strong{
      display:block;
      margin-top:7px;
      color:#ffffff;
      font-size:26px;
      line-height:1;
      font-weight:800;
    }

    .decision-window-list{
      display:grid;
      grid-template-columns:repeat(3, minmax(0, 1fr));
      gap:12px;
      margin-top:14px;
    }

    .decision-window{
      min-width:0;
      border-radius:16px;
      border:1px solid rgba(44,108,255,0.28);
      background:linear-gradient(180deg, rgba(44,108,255,0.11), rgba(255,255,255,0.025));
      overflow:hidden;
    }

    .decision-window-head{
      display:flex;
      align-items:center;
      justify-content:space-between;
