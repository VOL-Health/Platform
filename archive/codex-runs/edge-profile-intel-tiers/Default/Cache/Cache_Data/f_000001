      color:rgba(255,255,255,0.78);
      font-size:12px;
      line-height:1.45;
      font-weight:500;
    }

    .decision-without-note{
      margin-top:14px;
      padding:14px;
      border-radius:16px;
      border:1px solid rgba(246,180,75,0.22);
